# ForgeAI Environment Configuration Example

# Environment mode: development, testing, or production
ENVIRONMENT=development

# Database Connection (PostgreSQL is standard for dev/prod)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/forgeai

# JWT Security Key (MUST be set and at least 32 characters in dev/prod)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
